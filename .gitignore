# --- VS Code -----------------------------------------------------------------
# Machine-local editor state — never sync these.
globalStorage/
workspaceStorage/
History/
*.vsix

# --- zsh ---------------------------------------------------------------------
# History is personal and can contain secrets typed on a command line.
.zsh_history
zsh/.zsh_history
zsh/*_history
# Per-machine overrides, sourced but not tracked.
*.local

# --- Backups created by install.sh -------------------------------------------
.config-backup-*/

# --- OS noise ----------------------------------------------------------------
.DS_Store
Thumbs.db
*~

# --- Python helpers ----------------------------------------------------------
__pycache__/
*.pyc
